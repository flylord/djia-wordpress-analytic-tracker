{
	"name": "djia/ci-woocommerce",
	"description": "Sends WooCommerce server events to the Commerce Intelligence collector",
	"version": "1.0.0",
	"type": "wordpress-plugin",
	"license": "proprietary",
	"autoload": {
		"psr-4": {
			"CiWoocommerce\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"CiWoocommerce\\Tests\\": "tests/"
		}
	},
	"require": {
		"php": ">=7.4",
		"djia/php-analytic-tracker": "^1.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6"
	},
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "7.4.33"
		}
	}
}
